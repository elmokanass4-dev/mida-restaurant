# Build setting: enable API only on the same host that serves server/index.mjs.
VITE_BACKEND_ENABLED=true
# Server setting: exact public HTTPS origin (no path), required in production.
APP_ORIGIN=https://YOUR-HOST
NODE_ENV=production
PORT=3001
DATABASE_PATH=/app/data/mida.sqlite
# Set 1 only behind a trusted single reverse proxy; otherwise leave 0.
TRUST_PROXY_HOPS=0
